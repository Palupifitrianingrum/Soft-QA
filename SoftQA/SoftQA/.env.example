# Copy to backend/.env  (never commit real keys)
# Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Upload limits
MAX_UPLOAD_MB=10
# Sandbox (Docker) settings
SANDBOX_IMAGE=aura-qa-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# Semgrep: comma-separated registry rulesets (need network). Local rules in backend/rules always run.
SEMGREP_REGISTRY_CONFIGS=p/python,p/owasp-top-ten,p/secrets
# Database (SQLite by default; PostgreSQL later e.g. postgresql+psycopg://user:pw@host/db)
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
